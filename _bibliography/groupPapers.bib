@incollection{zhao2026GenAI,
title = {Generative AI for Mobile Edge Computing},
editor = {Songyang Zhang and Shuai Zhang and Chuan Huang},
booktitle = {Generative Learning for Wireless Communications},
publisher = {Academic Press},
pages = {289-305},
year = {2026},
isbn = {978-0-443-41497-8},
doi = {https://doi.org/10.1016/B978-0-44-341497-8.00023-7},
url = {https://www.sciencedirect.com/science/article/pii/B9780443414978000237},
author = {Taibiao Zhao and Xiaobing Chen and Mingxuan Sun and Xiangwei Zhou},
keywords = {Generative AI, Mobile edge computing},
abstract = {The convergence of Generative AI (GenAI) and Mobile Edge Computing (MEC) represents a transformative shift in intelligent systems, enabling real-time, privacy-preserving, and adaptive AI services closer to data sources. This chapter provides a comprehensive overview of the architectural foundations, optimization techniques, and technical innovations driving the deployment of generative models, such as large language models (LLMs), diffusion models, and GANs, at the network edge. It highlights the synergies between edge computing and GenAI, particularly in reducing latency, improving energy efficiency, and supporting dynamic applications in smart cities, autonomous systems, and real-time content generation. The chapter reviews recent advances in model compression, on-device training, and hybrid edge-cloud architectures, and explores key challenges related to hardware constraints, model complexity, and data privacy. Finally, it outlines future research directions, including scalable edge-cloud collaboration, explainable AI, and lightweight AI-generated content frameworks for personalized, context-aware services.}
}


